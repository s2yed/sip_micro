UCM_HOST=41.38.207.168
UCM_WSS_PORT=8089
UCM_WS_PORT=5060
UCM_WSS_PATH=/ws
SIP_PASSWORD=qwer369

# CLIENT_MODE options:
# 'register'   -> Normal manual registration (shows SetupScreen)
# 'anonymous'  -> Guest calling without accounts (depends on UCM Guest calling support)
# 'pool'       -> Auto-register silent guest using a pool of valid UCM extensions (recommened for UCM)
CLIENT_MODE=pool

# Pool of valid extensions on your UCM for clients to randomly select and register with.
# You can add multiple extensions separated by commas (e.g. 1034,1035,1036) to allow concurrent calls!
CLIENT_EXTENSIONS_POOL=1034,1029

# The customer service extension or queue number that clients will call when clicking the button.
DEFAULT_CALL_TARGET=1034
